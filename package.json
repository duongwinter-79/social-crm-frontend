{
  "name": "social-crm-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@8.19.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace @social-crm/crm-admin",
    "dev:candidate": "npm run dev --workspace @social-crm/candidate-portal",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "turbo": "^2.0.6",
    "typescript": "^5.6.3"
  }
}
